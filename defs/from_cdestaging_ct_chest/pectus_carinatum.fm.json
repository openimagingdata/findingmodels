{
  "oifm_id": "OIFM_MGB_646490",
  "name": "pectus carinatum",
  "description": "Anterior protrusion deformity of the chest wall in which the sternum and adjacent cartilages are displaced anteriorly. Typically described by presence, temporal status, severity, and any associated mediastinal mass effect.",
  "synonyms": [
    "pigeon chest",
    "chest wall protrusion",
    "anterior chest wall deformity"
  ],
