{
  "oifm_id": "OIFM_MGB_368153",
  "name": "acromioclavicular joint degenerative changes",
  "description": "Degenerative osteoarthritic changes affecting the acromioclavicular (AC) joint characterized by cartilage loss, osteophyte formation, subchondral sclerosis/cysts, and related capsular or distal clavicle changes.",
  "synonyms": [
    "ac joint degenerative changes",
    "acromioclavicular osteoarthritis",
    "ac joint osteoarthrosis"
  ],
  "tags": [
    "musculoskeletal",
    "joint",
    "degenerative",
    "acromioclavicular"
  ],
