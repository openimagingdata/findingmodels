{
  "oifm_id": "OIFM_MGB_658023",
  "name": "acromioclavicular joint degenerative changes",
  "description": "Degenerative changes affecting the acromioclavicular (AC) joint characterized by cartilage loss, joint space narrowing, osteophyte formation, subchondral sclerosis or cysts, capsular thickening, and possible distal clavicle osteolysis.",
  "synonyms": [
    "ac joint degenerative changes",
    "ac joint osteoarthritis",
    "acromioclavicular osteoarthritis",
    "ac joint degenerative disease"
  ],
  "tags": [
    "musculoskeletal",
    "shoulder",
    "joint",
    "degenerative",
    "osteoarthritis"
  ],
