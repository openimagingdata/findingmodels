{
  "oifm_id": "OIFM_MGB_441005",
  "name": "fibroelastoma",
  "description": "A small benign primary cardiac tumor classically arising from valvular endocardium (often papillary), which can cause embolic phenomena or valvular dysfunction. Typically appears as a mobile, pedunculated mass attached to a valve leaflet or annulus.",
  "synonyms": [
    "papillary fibroelastoma",
    "cardiac fibroelastoma"
  ],
  "tags": [
    "cardiac",
    "valve tumor",
    "cardiac mass",
    "echocardiography"
  ],
