{
  "oifm_id": "OIFM_MGB_034292",
  "name": "subendocardial fatty metaplasia",
  "description": "Localized or diffuse replacement of subendocardial myocardium with adipose tissue, typically identified on cardiac CT as low-attenuation subendocardial regions and often associated with prior myocardial infarction.",
  "synonyms": [
    "fatty metaplasia of myocardium",
    "subendocardial fat deposition",
    "myocardial fatty metaplasia"
  ],
  "tags": [
    "cardiac",
    "myocardium",
    "fatty metaplasia",
    "subendocardial",
    "ct"
  ],
