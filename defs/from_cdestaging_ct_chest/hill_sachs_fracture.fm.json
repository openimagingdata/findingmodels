{
  "oifm_id": "OIFM_MGB_478642",
  "name": "hill-sachs fracture",
  "description": "Compression/impaction fracture of the humeral head typically involving the posterolateral articular surface related to anterior shoulder dislocation; may also occur on the anterior humeral head in reverse injuries.",
  "synonyms": [
    "hill sachs lesion",
    "humeral head impression fracture",
    "humeral head compression fracture"
  ],
  "tags": [
    "shoulder",
    "trauma",
    "fracture",
    "glenohumeral instability"
  ],
