  "oifm_id": "OIFM_MGB_157003",
  "name": "left ventricular enlargement",
  "description": "Enlargement of the left ventricular chamber size relative to expected for body habitus, often reported on cardiac imaging (echocardiography, cardiac MRI) or chest radiography and characterized by degree, wall thickness, function, and associated findings.",
  "synonyms": [
    "left ventricular dilatation",
    "left ventricular dilatation/enlargement",
    "lv enlargement",
    "left ventricular hypertrophy (when thickened)"
  ],
