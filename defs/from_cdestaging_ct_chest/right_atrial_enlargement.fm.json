{
  "oifm_id": "OIFM_MGB_582164",
  "name": "right atrial enlargement",
  "description": "Enlargement of the right atrium identified on imaging or echocardiography, often reflecting pressure or volume overload and associated cardiac conditions. Characterized by presence, temporal status, degree of enlargement, wall thickness, and related cardiopulmonary findings.",
  "synonyms": [
    "ra enlargement",
    "right atrial dilatation",
    "right atrial dilation"
  ],
  "tags": [
    "cardiac",
    "right atrium",
    "chamber enlargement"
  ],
