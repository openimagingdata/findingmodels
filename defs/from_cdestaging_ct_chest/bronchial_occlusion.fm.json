  "oifm_id": "OIFM_MGB_201129",
  "name": "bronchial occlusion",
  "description": "Partial or complete blockage of a bronchus caused by intrinsic or extrinsic processes, leading to impaired airflow and possible distal complications such as atelectasis or pneumonia.",
