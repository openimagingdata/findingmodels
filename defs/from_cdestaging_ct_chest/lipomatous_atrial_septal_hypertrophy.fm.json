{
  "oifm_id": "OIFM_MGB_395180",
  "name": "lipomatous atrial septal hypertrophy",
  "description": "A focal fatty infiltration and thickening of the interatrial septum (lipomatous hypertrophy) typically involving the limbus of the fossa ovalis and sometimes extending into adjacent cardiac structures. Descriptors include presence, temporal change, measured septal thickness, CT attenuation, anatomic extent, and associated atrial enlargement.",
  "synonyms": [
    "lipomatous hypertrophy of interatrial septum",
    "lash",
    "lipomatous atrial septal hypertrophy (LASH)"
  ],
  "tags": [
    "cardiac",
    "atrial septum",
    "fatty infiltration",
    "cardiac ct"
  ],
