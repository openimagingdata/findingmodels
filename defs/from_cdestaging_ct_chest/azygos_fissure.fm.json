{
  "oifm_id": "OIFM_MGB_186106",
  "name": "azygos fissure",
  "description": "A congenital pleural variant where an invagination of the parietal pleura forms a fissure containing the azygos vein, often seen as an arch-like line in the right upper lung. Typically an incidental anatomical variant with potential associated imaging findings documented if present.",
  "synonyms": [
    "azygos lobe",
    "azygos fissure variant"
  ],
  "tags": [
    "anatomic variant",
    "pleural variant",
    "incidental finding"
  ],
