{
  "oifm_id": "OIFM_MGB_013228",
  "name": "extrapleural fat deposition",
  "description": "Localized or diffuse deposition of fat in the extrapleural space along the chest wall, typically seen on chest imaging (CT). Characterized by presence, location, extent, thickness, attenuation, and associated pleural or chest wall findings.",
  "synonyms": [
    "extrapleural fat pad",
    "extrapleural fat layer",
    "extrapleural fat collection",
    "extrapleural fat deposition scar"
  ],
  "tags": [
    "thorax",
    "pleura",
    "chest wall",
    "ct"
  ],
