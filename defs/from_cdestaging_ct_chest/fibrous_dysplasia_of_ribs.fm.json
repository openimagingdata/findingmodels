{
  "oifm_id": "OIFM_MGB_697988",
  "name": "fibrous dysplasia of ribs",
  "description": "Benign fibro-osseous replacement of normal bone within one or more ribs, characterized by variable radiographic appearance (eg, ground-glass, cystic, sclerotic) and potential deformity or fracture.",
  "synonyms": [
    "fibrous dysplasia rib",
    "rib fibrous dysplasia",
    "monostotic fibrous dysplasia ribs",
    "polyostotic fibrous dysplasia ribs"
  ],
  "tags": [
    "bone",
    "rib",
    "benign lesion",
    "fibro-osseous",
    "thoracic imaging"
  ],
