{
  "oifm_id": "OIFM_MGB_823440",
  "name": "diffuse idiopathic skeletal hyperostosis",
  "description": "Flowing calcification/ossification along the anterolateral aspect of the vertebral bodies consistent with diffuse idiopathic skeletal hyperostosis (DISH), characterized by contiguous bridging osteophytes and possible involvement of adjacent ligaments.",
  "synonyms": [
    "dish",
    "forestier disease",
    "diffuse skeletal hyperostosis"
  ],
