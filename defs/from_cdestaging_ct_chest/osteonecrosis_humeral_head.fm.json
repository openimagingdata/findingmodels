{
  "oifm_id": "OIFM_MGB_901674",
  "name": "osteonecrosis humeral head",
  "description": "Avascular necrosis (osteonecrosis) of the humeral head characterized by focal or diffuse bone ischemia that may lead to subchondral fracture, collapse, and articular surface change.",
  "synonyms": [
    "avascular necrosis humeral head",
    "humeral head osteonecrosis",
    "avascular necrosis proximal humerus"
  ],
