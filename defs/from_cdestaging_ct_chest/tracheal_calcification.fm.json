{
  "oifm_id": "OIFM_MGB_224997",
  "name": "tracheal calcification",
  "description": "Calcification involving the trachea, typically affecting tracheal cartilaginous rings or walls, seen on chest radiography or CT. Characterized by presence and temporal status, anatomic location and extent, tissue involvement and radiographic pattern, and related airway or soft-tissue findings.",
  "synonyms": [
    "tracheal ring calcification",
    "tracheal cartilage calcification",
    "tracheal wall calcification"
  ],
  "tags": [
    "airway",
    "chest",
    "calcification",
    "thorax",
    "ct",
    "radiography"
  ],
