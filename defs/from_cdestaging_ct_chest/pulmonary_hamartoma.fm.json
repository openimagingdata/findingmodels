  "oifm_id": "OIFM_MGB_751285",
  "name": "pulmonary hamartoma",
  "description": "Benign pulmonary nodule composed of disorganized mesenchymal tissue (cartilage, fat, connective tissue) typically appearing as a solitary well-circumscribed lung nodule that may contain fat and calcification.",
  "synonyms": [
    "chondroid hamartoma",
    "pulmonary chondroid hamartoma",
    "benign pulmonary nodule"
  ],
