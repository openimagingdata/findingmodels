{
  "oifm_id": "OIFM_MGB_560241",
  "name": "retrolisthesis",
  "description": "Posterior displacement of one vertebral body relative to the one below it. Characterized by location within the spine, severity grade (percent translation), affected levels, and associated findings such as foraminal narrowing or disc degeneration.",
  "synonyms": [
    "posterior vertebral displacement",
    "posterior slip"
  ],
  "tags": [
    "spine",
    "alignment",
    "retrolisthesis",
    "vertebral displacement"
  ],
