{
  "oifm_id": "OIFM_MGB_813794",
  "name": "pericardial cyst",
  "description": "A benign, fluid-filled lesion adjacent to the pericardium, most commonly occurring at the cardiophrenic angles. Described by presence, temporal status, location, size, morphology, wall characteristics, and associated complications such as mass effect, calcification, or rupture.",
  "synonyms": [
    "pericardial mesothelial cyst",
    "congenital pericardial cyst",
    "mediastinal cyst"
  ],
  "tags": [
    "cyst",
    "pericardial",
    "mediastinum",
    "cardiac imaging"
  ],
