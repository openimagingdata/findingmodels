{
  "oifm_id": "OIFM_MGB_420446",
  "name": "bronchial atresia",
  "description": "Congenital focal occlusion or discontinuity of a bronchus, often associated with a mucocele (bronchocele) and variable distal hyperinflation or atelectasis. Characterized by location, type, associated mucocele, and distal parenchymal effects.",
  "synonyms": [
    "congenital bronchial atresia",
    "bronchocele associated atresia"
  ],
  "tags": [
    "airway",
    "congenital",
    "pulmonary"
  ],
