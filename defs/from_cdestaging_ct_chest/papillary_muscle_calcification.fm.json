{
  "oifm_id": "OIFM_MGB_834557",
  "name": "papillary muscle calcification",
  "description": "Calcific deposition within one or more papillary muscles of the heart, typically identified on chest radiography, CT, or cardiac MRI. Characterized by presence, temporal status, anatomic location, and extent, with several commonly associated cardiac findings.",
  "synonyms": [
    "pap muscle calcification",
    "papillary muscle calcium",
    "papillary muscle calcified focus"
  ],
  "tags": [
    "cardiac",
    "calcification",
    "imaging finding",
    "cardiac imaging",
    "ventricle"
  ],
