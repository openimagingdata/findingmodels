{
  "oifm_id": "OIFM_MGB_635908",
  "name": "elastofibroma",
  "description": "Benign soft-tissue pseudotumor typically located in the subscapular/periscapular region characterized by fibrous and fatty components; commonly stable or slowly growing and often described by location, size, shape, margins, and effect on adjacent structures.",
  "synonyms": [
    "elastofibroma dorsi",
    "subscapular elastofibroma",
    "periscapular elastofibroma"
  ],
  "tags": [
    "soft tissue mass",
    "benign",
    "posterior chest wall",
    "musculoskeletal"
  ],
