{
  "oifm_id": "OIFM_MGB_554286",
  "name": "aortic dissection",
  "description": "A tear in the aortic intima creating a false lumen separated from the true lumen; may be acute or chronic and can involve variable aortic segments and branch vessels. Key report attributes include presence and status, anatomic type and extent, size of the entry tear, intimal flap status, and associated findings such as pericardial or pleural effusion and mediastinal hematoma.",
  "synonyms": [
    "dissection of aorta",
    "aortic intimal tear",
    "aortic false lumen"
  ],
  "tags": [
    "vascular",
    "cardiovascular",
    "emergency",
    "thoracic"
  ],
