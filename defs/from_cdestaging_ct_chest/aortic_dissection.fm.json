  "oifm_id": "OIFM_MGB_150878",
  "name": "aortic dissection",
  "description": "Separation of the aortic wall layers due to an intimal tear creating a true and false lumen; characterized by location, extent, entry tear size, and associated complications such as effusion or hematoma.",
  "synonyms": [
    "dissection of aorta",
    "aortic intimal flap",
    "aortic intramural dissection"
  ],
