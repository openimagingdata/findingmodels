  "oifm_id": "OIFM_MGB_494360",
  "name": "atrial septal defect asd",
  "description": "A congenital defect in the atrial septum allowing interatrial communication, characterized by location, size, shunt direction and magnitude, and effects on right heart chambers and pulmonary circulation.",
