{
  "oifm_id": "OIFM_MGB_608745",
  "name": "patent ductus arteriosus",
  "description": "A persistent vascular connection between the pulmonary artery and the aorta after birth, allowing abnormal shunting of blood. Characterized by size, shunt direction and associated cardiac or pulmonary effects.",
  "synonyms": [
    "pda",
    "patent ductus"
  ],
  "tags": [
    "cardiac",
    "congenital",
    "vascular",
    "echocardiography",
    "pediatric"
