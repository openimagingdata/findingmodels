{
  "oifm_id": "OIFM_MGB_025102",
  "name": "mediastinal cyst",
  "description": "A fluid-filled lesion within the mediastinum arising in the anterior, middle, posterior, or superior compartments. Characterized by size, shape, wall thickness, contents, and potential effects on adjacent structures or complications such as hemorrhage or infection.",
  "synonyms": [
    "mediastinal cystic lesion",
    "mediastinal cyst"
  ],
  "tags": [
    "mediastinum",
    "cyst",
    "thorax",
    "chest imaging"
  ],
