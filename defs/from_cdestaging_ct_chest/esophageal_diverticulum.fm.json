{
  "oifm_id": "OIFM_MGB_496642",
  "name": "esophageal diverticulum",
  "description": "Outpouching of the esophageal wall that may collect air, fluid, or food and can be located in cervical, mid‑esophageal, or epiphrenic regions. Described by presence, size, location, wall and content characteristics, enhancement, and related findings such as esophageal dilation or aspiration.",
  "synonyms": [
    "zenker diverticulum",
    "pharyngoesophageal diverticulum",
    "epiphrenic diverticulum",
    "mid esophageal diverticulum"
  ],
  "tags": [
    "esophagus",
    "diverticulum",
    "upper gi",
    "bowel"
  ],
