{
  "oifm_id": "OIFM_MGB_432782",
  "name": "subcutaneous emphysema",
  "description": "Air within the subcutaneous tissues (soft tissue emphysema) characterized by location, extent, temporal status, and associated thoracoabdominal injuries. Attributes capture presence, evolution, likely source of air, and related findings such as pneumothorax or pneumomediastinum to support clinical reporting.",
  "synonyms": [
    "subcut emphysema",
    "soft tissue emphysema",
    "subcutaneous air"
  ],
  "tags": [
