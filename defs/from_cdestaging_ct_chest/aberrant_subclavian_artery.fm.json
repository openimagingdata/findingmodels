{
  "oifm_id": "OIFM_MGB_760770",
  "name": "aberrant subclavian artery",
  "description": "An arterial variant in which the subclavian artery originates anomalously from the aortic arch or its branches and follows an atypical course; may compress adjacent structures and be associated with atherosclerosis or aneurysmal dilation.",
  "synonyms": [
    "lusorian artery",
    "aberrant right subclavian artery",
    "aberrant left subclavian artery"
  ],
  "tags": [
    "vascular",
    "congenital",
    "aortic arch anomaly",
    "thoracic vascular"
  ],
