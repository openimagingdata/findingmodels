{
  "oifm_id": "OIFM_MGB_795899",
  "name": "aberrant subclavian artery",
  "description": "An anomalous origin and/or course of a subclavian artery (commonly arteria lusoria) that deviates from the expected branching of the aortic arch. Describes side, course, associated compression, atherosclerotic changes, and aneurysmal dilation.",
  "synonyms": [
    "arteria lusoria",
    "lusorian artery",
    "aberrant right subclavian artery",
    "aberrant left subclavian artery"
  ],
  "tags": [
    "vascular anomaly",
    "congenital",
    "thoracic aorta",
    "branching anomaly"
  ],
